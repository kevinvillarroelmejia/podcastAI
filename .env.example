# Copia este archivo a .env y rellena tus claves. Nunca subas .env al repositorio.
# Sin claves, el backend arranca en MODO DE PRUEBA: guion con frases del PDF y audio en silencio.

# --- IA del guion (Claude) ---
ANTHROPIC_API_KEY=
# Modelos (opcional): mapa y verificación con Haiku, guion con Sonnet
# MAP_MODEL=claude-haiku-5-5
# SCRIPT_MODEL=claude-sonnet-5-5
# VERIFY_MODEL=claude-haiku-5-5

# --- Voz (OpenAI gpt-4o-mini-tts) ---
OPENAI_API_KEY=
# TTS_HOST_VOICE=coral     # Lía
# TTS_EXPERT_VOICE=ash     # Marco
# TTS_CONCURRENCY=2        # voces a la vez por podcast (súbelo si tu cuenta de OpenAI lo permite)

# --- Voz Premium (ElevenLabs v3, modo diálogo). Solo para cuentas Premium ---
ELEVENLABS_API_KEY=
# Voces (ids de tu biblioteca de ElevenLabs; elige voces en español para que suene natural)
# ELEVENLABS_HOST_VOICE=21m00Tcm4TlvDq8ikWAM    # Lía
# ELEVENLABS_EXPERT_VOICE=pNInz6obpgDQGcFmaJgB  # Marco
# ELEVENLABS_MODEL=eleven_v3

# --- Seguridad ---
# Secreto para firmar las URLs de audio (mínimo 32 caracteres). Genera uno con: openssl rand -base64 48
SIGNING_SECRET=
# Orígenes permitidos para la app web (separados por comas)
CORS_ORIGINS=*
# Valor que configuras en RevenueCat como "Authorization header" del webhook
REVENUECAT_WEBHOOK_SECRET=

# --- Base de datos (por defecto H2 en ./data). Para Supabase/PostgreSQL: ---
# DATABASE_URL=jdbc:postgresql://db.xxxxx.supabase.co:5432/postgres?sslmode=require
# DATABASE_USER=postgres
# DATABASE_PASSWORD=

# --- Otros ---
# Solo para probar en tu ordenador: todas las cuentas son Premium (voz ElevenLabs, modo A fondo, 120 min)
# DEV_PREMIUM=true
# PORT=8080
# STORAGE_DIR=./data/audio
# PUBLIC_BASE_URL=https://api.tudominio.com

# --- App (Expo). Va en app/.env ---
# EXPO_PUBLIC_API_URL=http://192.168.1.50:8080
